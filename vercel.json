{
  "functions": {
    "app/api/**/*.js": {
      "runtime": "@vercel/node@2.0.0"
    },
    "app/api/**/*.ts": {
      "runtime": "@vercel/node@2.0.0"
    }
  },
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/newsletter/publish",
      "schedule": "15 13 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.nataliagranato.xyz" }],
      "destination": "https://nataliagranato.xyz/:path*",
      "permanent": true
    }
  ]
}
