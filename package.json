{
  "name": "tailwind-nextjs-starter-blog",
  "version": "2.2.3",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "next dev",
    "dev": "cross-env INIT_CWD=$PWD next dev",
    "build": "node ./scripts/patch-contentlayer-otel.mjs && cross-env INIT_CWD=$PWD next build --webpack && cross-env NODE_OPTIONS='--experimental-json-modules' node ./scripts/postbuild.mjs",
    "postinstall": "node ./scripts/patch-contentlayer-otel.mjs",
    "serve": "next start",
    "analyze": "cross-env ANALYZE=true next build",
    "lint": "next lint --fix --dir pages --dir app --dir components --dir lib --dir layouts --dir scripts",
    "newsletter:test": "node scripts/newsletter-e2e.mjs"
  },
  "dependencies": {
    "@next/bundle-analyzer": "^15.5.2",
    "@tailwindcss/forms": "^0.5.4",
    "@tailwindcss/typography": "^0.5.9",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "autoprefixer": "^10.4.13",
    "contentlayer2": "^0.5.8",
    "esbuild": "^0.25.3",
    "estree-util-value-to-estree": "^3.3.3",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.2",
    "image-size": "^2.0.4",
    "micromatch": "^4.0.8",
    "next": "^16.4.3",
    "next-contentlayer2": "^0.5.8",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.2.1",
    "pliny": "^0.4.1",
    "postcss": "^8.5.32",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "reading-time": "^1.5.0",
    "redis": "^6.3.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-citation": "^2.2.1",
    "rehype-katex": "^7.0.1",
    "rehype-preset-minify": "^7.0.1",
    "rehype-prism-plus": "^2.0.0",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "tailwindcss": "^3.3.3",
    "unist-util-visit": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.5",
    "@types/node": "^25.0.3",
    "@types/react": "^19.0.1",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.5.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "typescript": "^6.0.0"
  },
  "resolutions": {
    "mdast-util-to-hast": ">=13.2.1"
  },
  "overrides": {
    "mdast-util-to-hast": ">=13.2.1",
    "postcss": "$postcss",
    "nanoid": "3.3.20",
    "source-map-js": "1.2.2",
    "sharp": "0.35.5",
    "svgo": "3.3.5",
    "protobufjs": "7.6.6",
    "@grpc/grpc-js": "1.14.6",
    "qs": "6.17.1",
    "browserslist": "4.29.5",
    "baseline-browser-mapping": "2.11.34",
    "probe-image-size": "7.5.0",
    "postcss-selector-parser": "6.1.5",
    "@babel/core": "7.29.7",
    "@humanfs/node": "0.16.8",
    "js-yaml": "4.3.2",
    "gray-matter": {
      "js-yaml": "3.15.2"
    },
    "toml": "5.0.1",
    "uuid": "11.1.1",
    "katex": "0.19.1",
    "brace-expansion": "2.1.7",
    "@eslint/config-array": {
      "brace-expansion": "1.1.21"
    },
    "@eslint/eslintrc": {
      "brace-expansion": "1.1.21"
    },
    "eslint": {
      "brace-expansion": "1.1.21"
    },
    "eslint-plugin-import": {
      "brace-expansion": "1.1.21"
    },
    "eslint-plugin-jsx-a11y": {
      "brace-expansion": "1.1.21"
    },
    "eslint-plugin-react": {
      "brace-expansion": "1.1.21"
    },
    "copyfiles": {
      "brace-expansion": "1.1.21"
    },
    "@typescript-eslint/typescript-estree": {
      "brace-expansion": "5.0.12"
    },
    "sucrase": {
      "brace-expansion": "2.1.7"
    },
    "zod": "$zod",
    "@opentelemetry/core": "2.9.0",
    "@opentelemetry/propagator-jaeger": "2.9.0",
    "@opentelemetry/propagator-b3": "2.9.0",
    "@opentelemetry/resources": "2.9.0",
    "@opentelemetry/sdk-trace": "2.9.0",
    "@opentelemetry/sdk-trace-base": "2.9.0",
    "@opentelemetry/sdk-trace-node": "2.9.0",
    "@opentelemetry/context-async-hooks": "2.9.0",
    "@opentelemetry/sdk-metrics": "2.9.0",
    "@opentelemetry/sdk-logs": "0.220.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.220.0",
    "@opentelemetry/otlp-exporter-base": "0.220.0",
    "@opentelemetry/otlp-grpc-exporter-base": "0.220.0",
    "@opentelemetry/otlp-transformer": "0.220.0",
    "next-themes": "$next-themes",
    "kbar": "1.0.0",
    "glob": "14.0.3",
    "superagent": "10.4.1"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  },
  "packageManager": "npm@11.6.2"
}
