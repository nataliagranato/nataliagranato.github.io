# Newsletter própria (SMTP + Redis em REDIS_URL). Passo a passo no README.
# Defina estas variáveis na Vercel em Production e em Preview.
# REDIS_URL já vem do Redis do Marketplace (redis://...). Local: redis://127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_REQUIRE_TLS=true
MAIL_FROM=Tech Preta <contato@nataliagranato.xyz>
NEWSLETTER_SECRET=
NEWSLETTER_PUBLISH_SECRET=
CRON_SECRET=
